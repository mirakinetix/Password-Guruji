<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.mirakinetix</groupId>
  <artifactId>password-guruji</artifactId>
  <version>0.1.0</version>
  <name>Password Guruji</name>
  <description>Offline-first encrypted password manager</description>
  <properties><maven.compiler.release>25</maven.compiler.release><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding><excluded.test.groups>desktop</excluded.test.groups></properties>
  <dependencies>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.12.2</version><scope>test</scope></dependency>
  </dependencies>
  <build><plugins>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-resources-plugin</artifactId><version>3.5.0</version>
      <!-- GHSA-6fmv-xxpf-w3cw: override the plugin's affected transitive version. -->
      <dependencies><dependency><groupId>org.codehaus.plexus</groupId><artifactId>plexus-utils</artifactId><version>4.2.0</version></dependency></dependencies>
    </plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-dependency-plugin</artifactId><version>3.11.0</version>
      <!-- GHSA-wxr5-93ph-8wr9: build-tool dependency only, never bundled in the app. -->
      <dependencies><dependency><groupId>commons-beanutils</groupId><artifactId>commons-beanutils</artifactId><version>1.11.0</version></dependency></dependencies>
    </plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.6.1</version>
      <configuration><excludedGroups>${excluded.test.groups}</excludedGroups><systemPropertyVariables><java.util.prefs.userRoot>${project.build.directory}/test-preferences</java.util.prefs.userRoot></systemPropertyVariables></configuration>
    </plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.16.0</version></plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.5.1</version>
      <configuration><archive><manifest><mainClass>com.mirakinetix.passwordguruji.PasswordGurujiApp</mainClass></manifest></archive></configuration>
    </plugin>
  </plugins></build>
  <profiles><profile><id>desktop</id><properties><excluded.test.groups>none</excluded.test.groups></properties></profile></profiles>
</project>
